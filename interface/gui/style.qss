QWidget {
    background-color: #f5f6f8;
    color: #1f2430;
    font-size: 14px;
}

QMainWindow {
    background-color: #f5f6f8;
}

QLabel {
    background: transparent;
}

QLabel#app_title {
    font-size: 22px;
    font-weight: 600;
    color: #3d5afe;
}

QLabel#placeholder_text {
    color: #8a8f98;
    font-size: 15px;
}

QLabel#section_label {
    color: #8a8f98;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 2px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #3d5afe;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
}

QPushButton:hover {
    background-color: #304ffe;
}

QPushButton:pressed {
    background-color: #2438c9;
}

QPushButton:disabled {
    background-color: #c8ccd6;
    color: #ffffff;
}

/* Chat list buttons: flat, own selected state */
QPushButton#chat_button {
    background-color: transparent;
    color: #1f2430;
    text-align: left;
    border-radius: 8px;
    padding: 8px 10px;
    font-weight: 400;
}

QPushButton#chat_button:hover {
    background-color: #e8eaf6;
}

QPushButton#chat_button:pressed {
    background-color: #dde0f3;
}

QPushButton#chat_button:checked {
    background-color: #3d5afe;
    color: #ffffff;
    font-weight: 600;
}

/* Chat list row: transparent so it doesn't paint a grey strip on the
   white left panel */
QWidget#chat_row {
    background: transparent;
}

/* Back out of settings, Cancel, Check: quiet, not the action of the page */
QPushButton#back_button, QPushButton#secondary_button {
    background-color: #eceef4;
    color: #4a5060;
}

QPushButton#back_button:hover, QPushButton#secondary_button:hover {
    background-color: #dde0ea;
    color: #1f2430;
}

QPushButton#back_button:pressed, QPushButton#secondary_button:pressed {
    background-color: #cdd2e0;
}

QPushButton#secondary_button:disabled {
    background-color: #eceef4;
    color: #a9aeb9;
}

/* Settings gear: neutral next to the accent-coloured Logout */
QPushButton#settings_button {
    background-color: #eceef4;
    color: #4a5060;
    border-radius: 8px;
    padding: 0px;
    font-size: 17px;
}

QPushButton#settings_button:hover {
    background-color: #dde0ea;
    color: #1f2430;
}

QPushButton#settings_button:pressed {
    background-color: #cdd2e0;
}

/* Delete button next to each chat: quiet until hovered */
QPushButton#chat_delete_button {
    background-color: transparent;
    color: #8a8f98;
    border-radius: 12px;
    padding: 0px;
    font-size: 13px;
}

QPushButton#chat_delete_button:hover {
    background-color: #ffe2e2;
    color: #c62828;
}

QPushButton#chat_delete_button:pressed {
    background-color: #ffcdd2;
    color: #b71c1c;
}

/* Shown next to the chat a task is running in */
QLabel#chat_busy_dot {
    color: #3d5afe;
    font-size: 10px;
    padding: 0px 2px;
}

/* --- Message box under the chat: looks like the other inputs --- */
QPlainTextEdit#prompt_input {
    border: 1px solid #dcdfe6;
    border-radius: 8px;
    padding: 3px 6px;
    background-color: #ffffff;
    selection-background-color: #a6b3ff;
}

QPlainTextEdit#prompt_input:focus {
    border: 1px solid #3d5afe;
}

/* Stop takes Send's place while a task is running */
QPushButton#stop_button {
    background-color: #e53935;
}

QPushButton#stop_button:hover {
    background-color: #d32f2f;
}

QPushButton#stop_button:pressed {
    background-color: #b71c1c;
}

/* Folder of the open chat, just above the message box */
QFrame#workspace_bar {
    background-color: #ffffff;
    border: 1px solid #e5e7ec;
    border-radius: 8px;
}

QLabel#workspace_path {
    color: #4a5060;
    font-size: 13px;
}

QPushButton#workspace_button {
    background-color: #eceef4;
    color: #4a5060;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
}

QPushButton#workspace_button:hover {
    background-color: #dde0ea;
    color: #1f2430;
}

QPushButton#workspace_button:pressed {
    background-color: #cdd2e0;
}

QPushButton#workspace_button:disabled {
    background-color: #eceef4;
    color: #a9aeb9;
}

/* Lined up with the text of the chat cells */
QLabel#thinking_text {
    color: #8a8f98;
    font-style: italic;
    padding: 2px 10px;
}

/* --- Tool approval card in the chat --- */
QFrame#approval_card {
    background-color: #fffbeb;
    border: 1px solid #f3dc8a;
    border-radius: 8px;
}

QFrame#approval_card[decided="true"] {
    background-color: #ffffff;
    border: 1px solid #e5e7ec;
}

QWidget#approval_buttons {
    background: transparent;
}

QPlainTextEdit#approval_details {
    background-color: #ffffff;
    border: 1px solid #efe3b8;
    border-radius: 6px;
    padding: 2px 4px;
    font-family: Menlo, Consolas, monospace;
    font-size: 12px;
}

QLabel#approval_summary {
    color: #4a5060;
    font-family: Menlo, Consolas, monospace;
    font-size: 12px;
}

QLabel#approval_allowed {
    color: #2e7d32;
    font-weight: 600;
}

QLabel#approval_denied {
    color: #c62828;
    font-weight: 600;
}

QLabel#approval_stopped {
    color: #8a8f98;
    font-weight: 600;
}

/* --- Inputs --- */
QLineEdit {
    border: 1px solid #dcdfe6;
    border-radius: 8px;
    padding: 8px;
    background-color: #ffffff;
    selection-background-color: #a6b3ff;
}

QLineEdit:focus {
    border: 1px solid #3d5afe;
}

QPlainTextEdit#form_text {
    border: 1px solid #dcdfe6;
    border-radius: 8px;
    padding: 4px;
    background-color: #ffffff;
    selection-background-color: #a6b3ff;
    font-family: Menlo, Consolas, monospace;
    font-size: 12px;
}

QPlainTextEdit#form_text:focus {
    border: 1px solid #3d5afe;
}

/* --- Panels & Cards --- */
QFrame#left_panel {
    background-color: #ffffff;
    border-right: 1px solid #e5e7ec;
}

QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e5e7ec;
    border-radius: 14px;
    padding: 20px;
}

/* --- Settings: MCP servers --- */
QWidget#server_list {
    background: transparent;
}

QFrame#server_row {
    background-color: #ffffff;
    border: 1px solid #e5e7ec;
    border-radius: 10px;
}

QFrame#server_form {
    background-color: #f8f9fc;
    border: 1px solid #e5e7ec;
    border-radius: 10px;
}

QLabel#server_name {
    font-weight: 600;
}

/* A server's tools, opened under its row */
QFrame#tools_panel {
    background-color: #f8f9fc;
    border: 1px solid #e5e7ec;
    border-radius: 8px;
}

QLabel#tool_name {
    font-family: Menlo, Consolas, monospace;
    font-size: 13px;
}

/* On/off switch of a server: green while it is on */
/* Column headings of the tools panel, over a line like a table's */
QFrame#tools_heading {
    background: transparent;
    border: none;
    border-bottom: 1px solid #e5e7ec;
}

QLabel#column_heading {
    color: #8a8f98;
    font-size: 12px;
    font-weight: 600;
}

/* Transparent, or it picks up the panel's grey. The indicator is drawn here
   too: once the widget is styled, the platform one can lose its outline. */
QCheckBox#auto_approve_check {
    background: transparent;
    spacing: 0px;
}

QCheckBox#auto_approve_check::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c8ccd6;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox#auto_approve_check::indicator:hover {
    border-color: #3d5afe;
}

QCheckBox#auto_approve_check::indicator:checked {
    border-color: #3d5afe;
    background-color: #3d5afe;
    image: url(icons:check.svg);
}

QCheckBox#auto_approve_check::indicator:checked:disabled {
    border-color: #b8c1f7;
    background-color: #b8c1f7;
}

QPushButton#toggle_button {
    background-color: #eceef4;
    color: #4a5060;
}

QPushButton#toggle_button:hover {
    background-color: #dde0ea;
}

QPushButton#toggle_button:checked {
    background-color: #e3f2e5;
    color: #2e7d32;
}

QPushButton#toggle_button:checked:hover {
    background-color: #d0ead4;
}

QPushButton#toggle_button:disabled {
    background-color: #eceef4;
    color: #a9aeb9;
}

QLabel#server_tag {
    background-color: #eceef4;
    color: #4a5060;
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 11px;
}

QLabel#hint_text {
    color: #8a8f98;
    font-size: 12px;
}

QLabel#error_text {
    color: #c62828;
    font-size: 12px;
}

/* --- Scroll --- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    width: 8px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #c8ccd6;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #a9aeb9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}