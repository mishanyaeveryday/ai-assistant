QWidget {
    background-color: #f5f6f8;
    color: #1f2430;
    font-size: 14px;
}

QMainWindow {
    background-color: #f5f6f8;
}

QLabel {
    background: transparent;
}

QLabel#app_title {
    font-size: 22px;
    font-weight: 600;
    color: #3d5afe;
}

QLabel#placeholder_text {
    color: #8a8f98;
    font-size: 15px;
}

QLabel#section_label {
    color: #8a8f98;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 2px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #3d5afe;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
}

QPushButton:hover {
    background-color: #304ffe;
}

QPushButton:pressed {
    background-color: #2438c9;
}

QPushButton:disabled {
    background-color: #c8ccd6;
    color: #ffffff;
}

/* Chat list buttons: flat, own selected state */
QPushButton#chat_button {
    background-color: transparent;
    color: #1f2430;
    text-align: left;
    border-radius: 8px;
    padding: 8px 10px;
    font-weight: 400;
}

QPushButton#chat_button:hover {
    background-color: #e8eaf6;
}

QPushButton#chat_button:pressed {
    background-color: #dde0f3;
}

QPushButton#chat_button:checked {
    background-color: #3d5afe;
    color: #ffffff;
    font-weight: 600;
}

/* Chat list row: transparent so it doesn't paint a grey strip on the
   white left panel */
QWidget#chat_row {
    background: transparent;
}

/* Back out of settings: quiet, it is not the action of the page */
QPushButton#back_button {
    background-color: #eceef4;
    color: #4a5060;
}

QPushButton#back_button:hover {
    background-color: #dde0ea;
    color: #1f2430;
}

QPushButton#back_button:pressed {
    background-color: #cdd2e0;
}

/* Settings gear: neutral next to the accent-coloured Logout */
QPushButton#settings_button {
    background-color: #eceef4;
    color: #4a5060;
    border-radius: 8px;
    padding: 0px;
    font-size: 17px;
}

QPushButton#settings_button:hover {
    background-color: #dde0ea;
    color: #1f2430;
}

QPushButton#settings_button:pressed {
    background-color: #cdd2e0;
}

/* Delete button next to each chat: quiet until hovered */
QPushButton#chat_delete_button {
    background-color: transparent;
    color: #8a8f98;
    border-radius: 12px;
    padding: 0px;
    font-size: 13px;
}

QPushButton#chat_delete_button:hover {
    background-color: #ffe2e2;
    color: #c62828;
}

QPushButton#chat_delete_button:pressed {
    background-color: #ffcdd2;
    color: #b71c1c;
}

/* --- Inputs --- */
QLineEdit {
    border: 1px solid #dcdfe6;
    border-radius: 8px;
    padding: 8px;
    background-color: #ffffff;
    selection-background-color: #a6b3ff;
}

QLineEdit:focus {
    border: 1px solid #3d5afe;
}

/* --- Panels & Cards --- */
QFrame#left_panel {
    background-color: #ffffff;
    border-right: 1px solid #e5e7ec;
}

QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e5e7ec;
    border-radius: 14px;
    padding: 20px;
}

/* --- Scroll --- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    width: 8px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #c8ccd6;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #a9aeb9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}