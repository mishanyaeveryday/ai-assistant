# Used by everyone who has not pasted a key of their own in Settings > Model
OPENROUTER_API_KEY=your_openrouter_api_key

# Any model id from https://openrouter.ai/models (optional, defaults to qwen/qwen3.8-flash).
# A model picked in Settings > Model wins over this one.
LLM_MODEL=qwen/qwen3.8-flash

# Models to switch to when LLM_MODEL fails, comma-separated (optional, off by default)
LLM_FALLBACK_MODELS=

# Model that looks at images for read_image and find_on_screen, whatever model answers in
# the chat (optional, defaults to google/gemini-3.8-flash). Other models miss their clicks.
# One without image input makes those tools warn instead.
VISION_MODEL=google/gemini-3.8-flash

TAVILY_API_KEY=your_tavily_api_key

DOCKER_CONTAINER=your_docker_container(optional)

WORKSPACE_DIR=/path/to/writable/folder(optional, defaults to ~/ai-assistant-workspace)

SCREENSHOT_DIR=/path/to/writable/folder(optional, defaults to ~/screenshots)
