OPENROUTER_API_KEY=your_openrouter_api_key

# Any model id from https://openrouter.ai/models (optional, defaults to google/gemini-3.8-flash)
LLM_MODEL=google/gemini-3.8-flash

# Models to switch to when LLM_MODEL fails, comma-separated (optional, off by default)
LLM_FALLBACK_MODELS=

# Model that looks at images for read_image, must accept image input (optional, defaults to google/gemini-3.8-flash)
VISION_MODEL=google/gemini-3.8-flash

TAVILY_API_KEY=your_tavily_api_key

DOCKER_CONTAINER=your_docker_container(optional)

WORKSPACE_DIR=/path/to/writable/folder(optional, defaults to ~/ai-assistant-workspace)

SCREENSHOT_DIR=/path/to/writable/folder(optional, defaults to ~/screenshots)
